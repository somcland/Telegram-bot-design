# Токен бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=

# Ключ Gemini с aistudio.google.com (необязательно): перевод английских статей и хайлайты.
GEMINI_API_KEY=
# Модель Gemini (по умолчанию gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Ключ Claude с console.anthropic.com (необязательно, запасной вариант, если Gemini не ответил)
ANTHROPIC_API_KEY=

# Твой Telegram id — только тебе бот покажет /stats (узнать id: напиши боту /stats)
ADMIN_IDS=
